{
  "name": "chariot",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "setup:sheets": "tsx --env-file-if-exists=.env src/setup.ts",
    "verify:sheets": "tsx --env-file-if-exists=.env verification-script.ts",
    "typecheck:verification": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "googleapis": "^182.0.0",
    "luxon": "^3.7.2"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.5",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
